rootname: , expr: void ase_tcp_port_free(struct ase_tcp_port *tp)
{
    if (tp->se != 0) {
        ASE_TRACE_INFO(tp->sess_ctx, ASE_CATE_TCP_PORT, "free %s port(%d) rcv %d snd %d, pkt_list(%d)",
            get_protol_str(tp), tp->se->fd, tp->rcv_bytes, tp->snd_bytes, List_Len(&tp->pkt_list));
        sched_evt_close(tp->se);
        ase_dfx_cnt_inc(ASE_DFX_CLOSE);
        tp->se = NULL;
    }
    if (tp->sess_ctx != NULL) {
        ase_str_mon_clean_sess_pkts_timeout(tp->sess_ctx->sess_id, tp->client);
        ase_sess_ctx_put(tp->sess_ctx, ase_sess_holder_net);
        tp->sess_ctx = NULL;
    }

    set_no_more_check_pkt_drop_on_pt(tp);

    if (tp->caps != NULL) {
        ase_sess_caps_put(tp->caps);
        tp->caps = NULL;
    }

    tcp_port_del_swp_timer(tp);
    ase_tcp_detach_peer(tp);
    ase_tcp_port_detach_sinks(tp);
    tp->drop_bytes += ase_buf_len(&tp->sndbuf);
    tp->pkt_stat->droped += ase_buf_len(&tp->sndbuf);
    ase_dfx_cnt_inc(ASE_DFX_DROP_STR, ase_buf_lsstrs(&tp->sndbuf));
    ase_buf_close(&tp->sndbuf);
    ase_tcp_stop_flush_ntfy(tp);
    ase_tcp_del_timeout_list(tp);
    ase_free(&g_tcp_port_mem_ctx.pmem.mem, tp);
}, kind: FunctionDecl, in_return_stmt: False, in_function: False, is_in_assignment: False
